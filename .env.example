# Local foundation works without Oracle. Fill ALL three values when a database is ready.
DJANGO_SETTINGS_MODULE=limousine.config.settings.local
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=

# Full Easy Connect string (host:port/service_name) or Autonomous TLS DSN.
# Keep passwords in this ignored .env file, never in a connection string or Git.
ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=

# Optional Autonomous mTLS wallet settings. Keep the wallet outside Git.
ORACLE_CONFIG_DIR=
ORACLE_WALLET_LOCATION=
ORACLE_WALLET_PASSWORD=

# Production only: enable solely after configuring the trusted HTTPS reverse proxy.
DJANGO_TRUST_PROXY=false
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
